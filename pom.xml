<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.acme</groupId>
    <artifactId>enterprise-agentic-test-framework</artifactId>
    <version>1.0.0</version>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.11.4</junit.version>
        <junit.platform.version>1.11.4</junit.platform.version>
        <cucumber.version>7.20.1</cucumber.version>
        <selenium.version>4.27.0</selenium.version>
        <restassured.version>5.5.0</restassured.version>
        <appium.version>9.3.0</appium.version>
        <allure.version>2.29.0</allure.version>
        <aspectj.version>1.9.25.1</aspectj.version>
        <jna.version>5.19.1</jna.version>
        <slf4j.version>2.0.16</slf4j.version>

        <!-- Default tag filter. CI overrides with -Dcucumber.tags="@api and not @wip".
             The runner class must NOT declare @ConfigurationParameter(FILTER_TAGS_PROPERTY_NAME),
             or the annotation will take precedence over this and silently ignore it. -->
        <cucumber.tags>not @wip</cucumber.tags>
        <allure.results.dir>${project.build.directory}/allure-results</allure.results.dir>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Aligns the Cucumber artifacts so cucumber-java and the platform engine
                 can never drift apart. -->
            <dependency>
                <groupId>io.cucumber</groupId>
                <artifactId>cucumber-bom</artifactId>
                <version>${cucumber.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Pins the transitive JNA resolution without adding an unused compile-scope
                 dependency to the framework artifact. jna and jna-platform MUST be the same
                 version: jna-platform is compiled against an exact jna, and any drift
                 produces NoClassDefFoundError: com/sun/jna/FunctionMapper at runtime.
                 Verify with: mvn dependency:tree -Dincludes=net.java.dev.jna -->
            <dependency>
                <groupId>net.java.dev.jna</groupId>
                <artifactId>jna</artifactId>
                <version>${jna.version}</version>
            </dependency>
            <dependency>
                <groupId>net.java.dev.jna</groupId>
                <artifactId>jna-platform</artifactId>
                <version>${jna.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Framework code (src/main/java) — compile scope -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>${restassured.version}</version>
        </dependency>
        <dependency>
            <groupId>io.appium</groupId>
            <artifactId>java-client</artifactId>
            <version>${appium.version}</version>
        </dependency>
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <version>23.6.0.24.10</version>
        </dependency>

        <!-- API only. Binding to an implementation in compile scope forces that
             binding on every consumer of this artifact and causes multiple-binding
             warnings. The implementation belongs at test scope, below. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <!-- Test-only dependencies (src/test/java) -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit-platform-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- DI for sharing scenario state between step classes. Without this,
             the first step class that needs a constructor argument fails to
             instantiate, and the usual workaround is a static field that breaks
             parallel execution. -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-picocontainer</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-cucumber7-jvm</artifactId>
            <version>${allure.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Unit tests of the framework itself. Runs on every build, must stay
                 hermetic: no browsers, no HTTP, no database. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- The Cucumber suite. Bound to integration-test, so `mvn test` and
                 `mvn install` never reach out to a live service. Run it with
                 `mvn verify`. Failsafe also defers failure reporting to the verify
                 phase so post-integration-test teardown still executes. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <includes>
                        <include>**/Run*IT.java</include>
                    </includes>
                    <systemPropertyVariables>
                        <cucumber.filter.tags>${cucumber.tags}</cucumber.filter.tags>
                        <cucumber.publish.quiet>true</cucumber.publish.quiet>
                        <allure.results.directory>${allure.results.dir}</allure.results.directory>
                        <fw.env>${env}</fw.env>
                    </systemPropertyVariables>
                    <!-- AspectJ weaver: required for Allure @Step annotations and
                         attachments. Without it the report generates but is largely empty. -->
                    <argLine>
                        -javaagent:"${settings.localRepository}/org/aspectj/aspectjweaver/${aspectj.version}/aspectjweaver-${aspectj.version}.jar"
                    </argLine>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Default environment when -Denv is not supplied. -->
        <profile>
            <id>default-env</id>
            <activation>
                <property>
                    <name>!env</name>
                </property>
            </activation>
            <properties>
                <env>local</env>
            </properties>
        </profile>
    </profiles>
</project>
